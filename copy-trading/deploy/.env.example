# Copier ce fichier en ".env" (gitignore) et le remplir. Aucun secret ici : la cle privee n'est JAMAIS dans ce fichier.
# Lu (jamais execute) par start / stop / report. Refuses : dublin-live et Up&Down-Tracing.
COPY_SSH_DEST=ubuntu@<IP-PUBLIQUE-DE-L-INSTANCE>
COPY_SSH_KEY=~/.ssh/<ma-cle>.pem
# wallet suivi (proxy wallet public 0x...) ; defaut : celui de config.example.json
COPY_WALLET=0xf0318c32136c2db7fec88b84869aee6a1106c80c
