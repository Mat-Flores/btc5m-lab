# Copier ce fichier en ".env" (gitignore) et le remplir. Aucun secret ne doit etre commite.
# Lu (jamais execute) par start / stop / pull.
TRACING_SSH_DEST=ubuntu@<IP-PUBLIQUE-DE-L-INSTANCE>
TRACING_SSH_KEY=~/.ssh/<ma-cle>.pem
# optionnel : identifiant ecrit dans les traces (defaut : tracing)
# TRACING_HOST_ID=tracing
# optionnels (tests / cas particuliers) : REMOTE_TRACE_ROOT, REMOTE_USER, REMOTE_CONFIG
# PT_TEST_NOSSH=1 : tests uniquement, execute les commandes "serveur" en local (voir tests/)
