#!/usr/bin/env bash
# report : synthese structuree et coloree (<= 15 lignes) du journal, en paper comme en live
# (observe, demande, reel) et latences mediane / p90 par segment. Lecture seule.
# Usage : report
set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
case "${1:-}" in -h|--help) sed -n '2,4p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;; "") ;; *) die "option inconnue : $1" ;; esac
load_env
check_conn
installed || die "copy-trading n'est pas installe sur ce serveur"
rsh "test -s $R_JOURNAL" || die "journal vide ou absent ($R_JOURNAL) : lancer d'abord deploy/start"
COLOR=0
[ -t 1 ] && [ -z "${NO_COLOR:-}" ] && COLOR=1
SERVICE=$(svc_state)
LIVE_PID=$(live_pid)
LOCK=0
lock_present && LOCK=1
if [ "$SERVICE" != active ] && [ -n "$LIVE_PID" ]; then SERVICE=active; fi
case "$SERVICE" in active|failed) ;; *) SERVICE=inactive ;; esac
rsh "COPY_REPORT_COLOR=$COLOR COPY_REPORT_SERVICE=$SERVICE COPY_REPORT_LIVE_PID=$LIVE_PID COPY_REPORT_LIVE_LOCK=$LOCK $APP/bin/copy-trading report $R_JOURNAL" || die "lecture du journal impossible"
