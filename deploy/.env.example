# Variables lues par deploy/pull-traces (noms seulement ; IP et cle passees en arguments).
# REMOTE_TRACE_ROOT=          racine des traces sur le serveur (defaut /var/lib/updown5m/trace)
# REMOTE_USER=                utilisateur sudo pour lire/supprimer cote serveur (defaut tgap)
# PT_TEST_NOSSH=              tests uniquement : 1 = executer les commandes "serveur" en local (sans ssh ni sudo)
# Variables lues par deploy/deploy.sh :
# DEPLOY_HOST_ID=             host_id ecrit dans config.json a la 1re installation (defaut dry-run)
