# Unit modele : instances updown5m@tracing et updown5m@ui.
# Un seul ExecStart est possible pour un modele : systemd interdit une variable en position de
# commande, donc un petit sh choisit la commande selon %i (aucun autre fichier a maintenir).
# Le "$$" est l'echappement systemd du "$" du shell.
[Unit]
Description=updown5m %i
After=network-online.target chrony.service
Wants=network-online.target

[Service]
User=tgap
Group=tgap
WorkingDirectory=/opt/updown5m
Environment=TRACE_CONFIG=/var/lib/updown5m/config.json
Environment=TRACE_ROOT=/var/lib/updown5m/trace
Environment=HOST=127.0.0.1
Environment=PORT=8787
ExecStart=/bin/sh -c 'case "$$1" in tracing) exec /opt/updown5m/bin/source-tracing --config "$$TRACE_CONFIG";; ui) exec /usr/local/bin/node /opt/updown5m/ui/server.mjs;; *) echo "instance inconnue: $$1" >&2; exit 1;; esac' sh %i
Restart=always
RestartSec=3
# SIGTERM : le tracer ecrit disconnect{shutdown} + end{shutdown} et ferme son membre gzip
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
# config.json (/var/lib/updown5m, renomme atomiquement par l'UI) et traces : seul /var/lib/updown5m est inscriptible
ReadWritePaths=/var/lib/updown5m
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
